{
    "openapi": "3.0.0",
    "info": {
        "title": "SIGEDOR API",
        "description": "Documentación de la API del Sistema de Gestión Docente y Reportes (SIGEDOR).",
        "contact": {
            "email": "soporte@sigedor.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://my-default-host.com",
            "description": "Servidor Principal de API"
        }
    ],
    "paths": {
        "/api/v1/reports": {
            "get": {
                "tags": [
                    "Reportes"
                ],
                "summary": "Listar reportes académicos",
                "description": "Obtiene la lista de reportes emitidos en el sistema.",
                "operationId": "4732399f75f35a75d93d3db8cecc3c56",
                "responses": {
                    "200": {
                        "description": "Listado de reportes obtenido exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/teachers": {
            "get": {
                "tags": [
                    "Docentes"
                ],
                "summary": "Listar docentes del sistema",
                "description": "Obtiene la lista paginada de docentes con sus relaciones institucionales.",
                "operationId": "4e0c8bfeeb2fe7d4a33d7b6b6515d50d",
                "parameters": [
                    {
                        "name": "sede_id",
                        "in": "query",
                        "description": "Filtrar por ID de sede",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de docentes obtenido exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/ping": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Verificar estado de la API",
                "operationId": "30dd9cf96775eba8d3a5118c5b5b9ee5",
                "responses": {
                    "200": {
                        "description": "API funcionando correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "title": "Usuario",
                "description": "Modelo de Usuario del Sistema SIGEDOR",
                "properties": {
                    "id": {
                        "description": "Modelo de Usuario del Sistema SIGEDOR.\n\nRepresenta a los usuarios del sistema (Administradores, Jefes de Área y Docentes),\nintegrando autenticación, autorización basada en roles (Spatie), borrado lógico\ny control de acceso a paneles de Filament.",
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "is_approved": {
                        "type": "boolean"
                    },
                    "sede_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "area_id": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Reportes",
            "description": "Reportes"
        },
        {
            "name": "Docentes",
            "description": "Docentes"
        },
        {
            "name": "Health",
            "description": "Health"
        }
    ]
}